 "plan_metric_roles": {
  "phrase_len_bars": {
   "role": "descriptive",
   "why": "乐句长度（本工具按 4 小节切）"
  },
  "phrase_travel_mean": {
   "role": "diagnostic",
   "why": "每句「起音→目标音」的平均音程（半音）：过大=每句都在大跳，过小=句子没有方向"
  },
  "phrase_travel_max": {
   "role": "descriptive",
   "why": "最远的一句走了多少半音"
  },
  "phrase_travel_span_ratio": {
   "role": "diagnostic",
   "why": "句内行程 / 全曲音域：接近 1 = 每句都跑遍全场（无音区层级）"
  },
  "breath_share": {
   "role": "diagnostic",
   "why": "有呼吸点的乐句占比：0 = 全曲不换气"
  },
  "breath_pos_in_phrase": {
   "role": "descriptive",
   "why": "呼吸点落在句内的相对位置（0=句首，1=句尾）"
  },
  "motif_recurrence": {
   "role": "diagnostic",
   "why": "以同一手势起句的乐句占比：高 = 动机被反复使用（Wait Day 0.67）"
  },
  "climax_position": {
   "role": "style",
   "why": "全曲最高音的位置（占比）"
  },
  "section_non4_share": {
   "role": "style",
   "why": "长度不是 4 倍数的段落占比"
  },
  "energy_fluctuation": {
   "role": "diagnostic",
   "why": "逐段能量（密度）相对均值的起伏：0 = 一条平线"
  }
 }
